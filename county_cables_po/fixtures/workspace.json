  "content": "[{\"id\": \"a521c1c04d\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\">Reorder Management</span>\", \"col\": 12}}, {\"id\": \"a1cc185fdf\", \"type\": \"paragraph\", \"data\": {\"text\": \"<p>Recalculated nightly from Sales Invoice history and current stock. Items in <b>Critical</b> will stock out before a new order can land - act on these first. Order-by dates assume the lead time shown per item (default 2 months unless set on the Item).</p>\", \"col\": 12}}, {\"id\": \"422352fb01\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h5\\\">Overview</span>\", \"col\": 12}}, {\"id\": \"ef8910bcb7\", \"type\": \"number_card\", \"data\": {\"number_card_name\": \"Items Critical\", \"col\": 3}}, {\"id\": \"8c9d82a922\", \"type\": \"number_card\", \"data\": {\"number_card_name\": \"Items Reorder Now\", \"col\": 3}}, {\"id\": \"f912c15c7f\", \"type\": \"number_card\", \"data\": {\"number_card_name\": \"Total Suggested Order Value\", \"col\": 3}}, {\"id\": \"6011689923\", \"type\": \"number_card\", \"data\": {\"number_card_name\": \"Dormant Capital\", \"col\": 3}}, {\"id\": \"cc5db9525b\", \"type\": \"chart\", \"data\": {\"chart_name\": \"Reorder Status Breakdown\", \"col\": 12}}, {\"id\": \"209279e303\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h5\\\">Reports</span>\", \"col\": 12}}, {\"id\": \"6fe435d300\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Action View\", \"col\": 4}}, {\"id\": \"06c0ecc1ca\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Dormant Stock View\", \"col\": 4}}, {\"id\": \"9b126845df\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Dead SKUs View\", \"col\": 4}}, {\"id\": \"30560588bc\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h5\\\">Item Management</span>\", \"col\": 12}}, {\"id\": \"6977b8ed9a\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Reorder Recommendation\", \"col\": 6}}, {\"id\": \"da52efeabe\", \"type\": \"sho